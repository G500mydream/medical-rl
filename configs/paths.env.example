# Copy to configs/paths.env and edit.
export BASE_MODEL="Qwen/Qwen3-4B-Instruct-2507"
export SFT_OUT="outputs/qwen3-4b-lora-sft"
export GRPO_OUT="outputs/qwen3-4b-grpo"
export MOPD_OUT="outputs/qwen3-4b-mopd"
export TEACHER_DIR="outputs/teachers"

export DATA_DIR="data/processed"

# Rubric judge. Use gpt-4.1 for the final table, a cheaper model for iteration.
export JUDGE_MODEL="gpt-4.1-mini"
export JUDGE_CACHE=".cache/judge"
export OPENAI_API_KEY=""

# Reward shaping
export RUBRIC_DROPOUT="0.3"
export LENGTH_PENALTY="0.0005"
export SOFT_MAX_TOKENS="800"

export WANDB_PROJECT="medical-sft-grpo-mopd"
export CUDA_VISIBLE_DEVICES="0,1,2,3,4,5,6,7"
export TOKENIZERS_PARALLELISM="false"
